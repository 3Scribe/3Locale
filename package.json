{
  "name": "three-locale",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "start": "node ./dist/server/entry.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "cf:types": "wrangler types worker-configuration.d.ts",
    "dev:cloudflare": "astro dev --config astro.cloudflare.config.mjs --host 127.0.0.1",
    "build:cloudflare": "astro build --config astro.cloudflare.config.mjs",
    "preview:cloudflare": "astro preview --config astro.cloudflare.config.mjs --host 127.0.0.1",
    "db:migrate:local": "wrangler d1 migrations apply THREELOCALE_DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply THREELOCALE_DB --remote",
    "deploy": "npm run build:cloudflare && npm run db:migrate:remote && wrangler deploy --config dist-cloudflare/server/wrangler.json",
    "test:d1": "vitest run --config vitest.d1.config.ts",
    "test:cloudflare": "playwright test --config playwright.cloudflare.config.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@astrojs/node": "^11.1.6",
    "@astrojs/react": "^7.0.0",
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "i18next": "^26.4.2",
    "jsonc-parser": "^3.3.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^1.7.0",
    "miniflare": "^5.20260923.0-alpha",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1",
    "wrangler": "^4.140.0"
  },
  "license": "AGPL-3.0-only",
  "cloudflare": {
    "bindings": {
      "THREELOCALE_DB": {
        "description": "Stores 3Locale Community projects, translations, audit events and revisions. This instance has no authentication."
      }
    }
  }
}
